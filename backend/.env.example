# Server
NODE_ENV=development
PORT=4511

# Database
MONGODB_URI=mongodb://localhost:27017/mecfinders

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SuperAdmin Seed
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@mecfinders.com
SUPERADMIN_PASSWORD=change-this-strong-password

# CORS
ADMIN_PANEL_URL=http://localhost:4512

# Razorpay (online booking payments). Leave blank to disable online payments —
# the app then falls back to cash-only. The customer pays the full amount
# (service + GST + platform fee) to the platform; the mechanic's service-price
# earning is held as a payable and settled to them manually from the admin
# wallet (Mechanic Wallets → Settle). RAZORPAY_WEBHOOK_SECRET is the secret you
# set when creating the webhook in the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Admin (REQUIRED for mobile apps). The customer/mechanic apps sign in
# with Firebase phone-OTP and send the resulting ID token; the backend verifies
# it here and trusts ONLY the decoded uid/phone. Without these, mobile
# login/register fail closed (they never trust the client). Get them from the
# Firebase console → Project settings → Service accounts → Generate new private
# key, then copy the three fields. Keep the private key's newlines as literal
# "\n" on one line (the backend converts them back).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternatively, drop the downloaded JSON at src/config/service-account.json
# (gitignored) instead of setting the three vars above.

# CORS: comma-separated browser origins allowed to call the API WITH cookies
# (admin panel + any staging/prod web origins). Localhost + capacitor origins
# are always allowed. Native mobile apps send no Origin and use Bearer tokens.
# In production, origins NOT listed here are rejected.
CORS_ORIGINS=https://admin.yourdomain.com

# Auth user-lookup cache TTL (seconds). authenticate() caches the user doc this
# long (Redis if configured, else in-process) to avoid a DB read per request.
# A ban/profile change takes effect within this window (and immediately on
# logout/deactivate, which invalidate the entry).
USER_CACHE_TTL_S=30

# --- Scaling (all optional; sane defaults if unset) ---

# MongoDB connection pool. With N app processes, N * MONGO_MAX_POOL must stay
# under your Atlas tier's connection limit (M0 ~500, M10 ~1500).
MONGO_MAX_POOL=50
MONGO_MIN_POOL=5
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_SOCKET_TIMEOUT_MS=45000

# Redis — set this to run MORE THAN ONE app process. It enables cross-process
# Socket.IO (realtime works across instances) and a leader-lock so only ONE
# process runs the dispatch sweeper. Leave BLANK for single-process mode.
# REDIS_URL=redis://127.0.0.1:6379

# Reverse proxy: 'loopback' for local, or set to the proxy hop count / 'true'
# when behind Nginx / a load balancer so real client IPs are used.
TRUST_PROXY=loopback

# Request body size cap (webhooks use raw body separately).
JSON_BODY_LIMIT=1mb
# Larger cap applied ONLY to the base64-image upload endpoints
# (register / profile-image / documents / service image+banner).
UPLOAD_BODY_LIMIT=15mb

# Global rate-limit backstop (requests per minute per user/IP).
RATE_LIMIT_GLOBAL_PER_MIN=300

# Reference-data cache TTL (seconds) for categories/services/pricing.
CACHE_REFERENCE_TTL_S=60

# Dispatch sweeper batch size (expired offers processed per 5s tick).
DISPATCH_SWEEP_BATCH=200

# Unique id per process (auto-derived from pid@host if unset). Useful in logs
# when running a cluster to see which process holds the sweeper lock.
# INSTANCE_ID=
